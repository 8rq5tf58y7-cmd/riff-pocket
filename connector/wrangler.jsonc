{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename if you like; your connector URL becomes https://<name>.<your-subdomain>.workers.dev/mcp
  "name": "riff-pocket-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Client ID Metadata Documents (how Claude identifies itself) are fetched from client-supplied
  // URLs; this flag stops those fetches from reaching private addresses.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // `npx wrangler kv namespace create OAUTH_KV` and `npx wrangler d1 create riff-pocket` print these ids.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "riff-pocket", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ]
  // Secrets (never in this file): OWNER_PASSWORD, SYNC_KEY — `npx wrangler secret put <NAME>`.
}
